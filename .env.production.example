# THIS IS A TEMPLATE FILE ONLY.
# Actual secrets should be created on the VPS as `.env`.

SONGSLIDE_ENV=production
TZ=Asia/Jakarta
COMPOSE_PROJECT_NAME=songslide

FRONTEND_PORT=3000
BACKEND_INTERNAL_URL=http://songslide-backend:8080
NEXT_PUBLIC_API_BASE_URL=https://api-songslide.berutu.dev

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
BACKEND_CORS_ALLOWED_ORIGINS=https://songslide.berutu.dev

POSTGRES_HOST=songslide-postgres
POSTGRES_PORT=5432
POSTGRES_DB=songslide
POSTGRES_USER=songslide
POSTGRES_PASSWORD=change-me-with-strong-production-password
DATABASE_URL=jdbc:postgresql://songslide-postgres:5432/songslide

STORAGE_PROVIDER=local
STORAGE_ROOT=/app/storage
MAX_SOURCE_IMAGE_SIZE_MB=10

EXPORT_SERVICE_URL=http://songslide-export-service:3001
EXPORT_SERVICE_PORT=3001
EXPORT_DEFAULT_SLIDE_SIZE=16:9

OCR_ENABLED=false
