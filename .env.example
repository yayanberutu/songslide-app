# SongSlide local development environment
# Copy to .env when local service scaffolds exist. Do not commit real secrets.

# Application
SONGSLIDE_ENV=local
TZ=Asia/Jakarta

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Backend
BACKEND_PORT=8080
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=songslide
POSTGRES_USER=songslide
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=jdbc:postgresql://localhost:5432/songslide

# Canonical content model
# Song content is stored in song_arrangements.content_json JSONB.
# song_verses and notation_lines are not primary MVP tables.
SONG_ARRANGEMENT_STRUCTURE_VERSION=1.0

# Local filesystem storage
STORAGE_PROVIDER=local
STORAGE_ROOT=./.local-storage
MAX_SOURCE_IMAGE_SIZE_MB=10

# Export service
EXPORT_SERVICE_URL=http://localhost:3002
EXPORT_SERVICE_PORT=3002
EXPORT_DEFAULT_SLIDE_SIZE=16:9

# OCR service
# OCR is optional and disabled by default for MacBook Pro 2017 local development.
OCR_ENABLED=false
OCR_SERVICE_URL=http://localhost:8001
OCR_SERVICE_PORT=8001

# Docker Compose
COMPOSE_PROJECT_NAME=songslide
